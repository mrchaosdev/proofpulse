# ProofPulse environment template.
# Copy to .env.local and fill in. Never commit a filled file.
# Every value below is server-only. No secret may use a NEXT_PUBLIC_ prefix.

# Nansen API key. Required for APP_MODE=live. Server-only.
NANSEN_API_KEY=

# Base URL for the Nansen API. Fixed origin; never derived from user input.
NANSEN_BASE_URL=https://api.nansen.ai

# Model provider credentials for the evidence-grounded brief. Optional:
# without them the deterministic brief is used.
MODEL_API_KEY=
MODEL_NAME=

# Cache backend. Optional locally; memory cache is used when unset.
CACHE_URL=
CACHE_TOKEN=

# Default data source for the server: live or fixture.
# The interface labels the active mode regardless of this value.
APP_MODE=fixture

# Explicit fixture selection when APP_MODE=fixture.
FIXTURE_SET=demo-investigation
