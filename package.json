{
  "name": "proofpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format-check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test-contract": "vitest run --project contract --passWithNoTests",
    "test-integration": "vitest run --project integration --passWithNoTests",
    "test-e2e": "playwright test",
    "check-classes": "node scripts/check-class-names.mjs",
    "check-secrets": "node scripts/check-secrets.mjs",
    "spike-nansen": "node scripts/spike-nansen.mjs",
    "quality": "npm run format-check && npm run lint && npm run typecheck && npm run check-classes && npm run check-secrets && npm run test && npm run test-contract && npm run test-integration && npm run build"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
